{
  "schemaVersion": 1,
  "id": "capeswitcher",
  "version": "${version}",
  "name": "Cape Switcher",
  "description": "A client-side mod that allows you to choose a local custom cape from a folder.",
  "authors": [
    "IcyCrow"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.pavel.capeswitcher.CapeSwitcherClient"
    ]
  },
  "mixins": [
    "capeswitcher.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
